From f54a5e2d928d9411dc712f7d11d65495616bfee0 Mon Sep 17 00:00:00 2001
From: dkati <dkatikaridis@gmail.com>
Date: Sun, 14 Oct 2018 02:07:04 +0300
Subject: [PATCH 2/3] bionic: Enable -O3

Change-Id: Ia82860326de114d48dea0e8cd93b836f1e826e15
Signed-off-by: Adithya R <gh0strider.2k18.reborn@gmail.com>
---
 benchmarks/Android.bp | 3 ++-
 libc/Android.bp       | 2 ++
 libdl/Android.bp      | 2 ++
 libm/Android.bp       | 1 +
 linker/Android.bp     | 3 +++
 5 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/benchmarks/Android.bp b/benchmarks/Android.bp
index 5f8c11306..0c43522c5 100644
--- a/benchmarks/Android.bp
+++ b/benchmarks/Android.bp
@@ -17,7 +17,7 @@
 cc_defaults {
     name: "bionic-benchmarks-defaults",
     cflags: [
-        "-O2",
+        "-O3",
         "-fno-builtin",
         "-Wall",
         "-Wextra",
@@ -71,6 +71,7 @@ cc_defaults {
         "-Wextra",
         "-Werror",
         "-Wunused",
+        "-O3",
     ],
 }
 
diff --git a/libc/Android.bp b/libc/Android.bp
index ce714054a..7bde4b591 100644
--- a/libc/Android.bp
+++ b/libc/Android.bp
@@ -37,6 +37,7 @@ libc_common_flags = [
     "-Wno-deprecated-declarations",
     "-Wno-gcc-compat",
     "-Wframe-larger-than=2048",
+    "-O3",
 
     // Try to catch typical 32-bit assumptions that break with 64-bit pointers.
     "-Werror=pointer-to-int-cast",
@@ -1963,6 +1964,7 @@ cc_defaults {
         "-Wno-gcc-compat",
         "-Wall",
         "-Werror",
+        "-O3",
     ],
     sanitize: {
         never: true,
diff --git a/libdl/Android.bp b/libdl/Android.bp
index 8e3a3fc25..be39233b6 100644
--- a/libdl/Android.bp
+++ b/libdl/Android.bp
@@ -18,6 +18,7 @@ cc_library_static {
         "-Wextra",
         "-Wunused",
         "-Werror",
+        "-O3",
     ],
 
     // For private/CFIShadow.h.
@@ -169,6 +170,7 @@ cc_library {
         "-Wextra",
         "-Wunused",
         "-Werror",
+        "-O3",
     ],
 
     stl: "none",
diff --git a/libm/Android.bp b/libm/Android.bp
index 1c4fe551a..e8335ce9f 100644
--- a/libm/Android.bp
+++ b/libm/Android.bp
@@ -476,6 +476,7 @@ cc_library {
         "-Wno-unknown-pragmas",
         "-Wno-unused-const-variable",
         "-Wno-unused-variable",
+        "-O3",
     ],
 
     ldflags: [
diff --git a/linker/Android.bp b/linker/Android.bp
index 582a9e41e..717f13d5a 100644
--- a/linker/Android.bp
+++ b/linker/Android.bp
@@ -33,6 +33,7 @@ cc_object {
         "-Wextra",
         "-Wno-unused",
         "-Werror",
+        "-O3",
     ],
 
     srcs: [
@@ -78,6 +79,7 @@ cc_defaults {
         "-Wextra",
         "-Wunused",
         "-Werror",
+        "-O3",
     ],
 
     // TODO: split out the asflags.
@@ -401,6 +403,7 @@ cc_library {
         "-Wextra",
         "-Wunused",
         "-Werror",
+        "-O3",
     ],
     stl: "none",
 
-- 
2.43.0

